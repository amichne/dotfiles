#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
if [[ $(uname -s) != Linux || ! -f /etc/debian_version || "$root" == "$HOME" ]]; then
    printf 'orb setup: requires a Debian checkout outside HOME; not an installer for live dotfiles\n' >&2
    exit 69
fi
cd -- "$root"
started=$SECONDS

# Match containers/Dockerfile. Do not install the personal mise toolbox or HOME files.
printf '==> Debian check tools\n'
missing=()
for package in ca-certificates curl git libatomic1 libstdc++6 neovim shellcheck xz-utils zsh; do
    if [[ $(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true) != 'install ok installed' ]]; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    elevate=()
    if ((EUID != 0)); then
        elevate=(sudo -n)
    fi
    "${elevate[@]}" apt-get update
    "${elevate[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi
printf '==> Debian tools ready (%ss)\n' "$((SECONDS - started))"

tools="$HOME/.local/share/dotfiles-orb"
download=$(mktemp -d)
trap 'rm -rf -- "$download"' EXIT
export PATH="$tools/bin:$tools/node/bin:$PATH"

printf '==> uv 0.12.9 and Node 26.0.0\n'
if [[ ! -x "$tools/bin/uv" || $("$tools/bin/uv" --version | cut -d ' ' -f 2) != 0.12.9 ]]; then
    curl --fail --silent --show-error --location --retry 3 \
        https://astral.sh/uv/0.12.9/install.sh --output "$download/uv-install.sh"
    UV_UNMANAGED_INSTALL="$tools/bin" bash "$download/uv-install.sh"
fi
if [[ ! -x "$tools/node/bin/node" || $("$tools/node/bin/node" --version) != v26.0.0 ]]; then
    case $(uname -m) in
        x86_64) arch=x64 ;;
        aarch64) arch=arm64 ;;
        *) printf 'orb setup: unsupported Node architecture\n' >&2; exit 69 ;;
    esac
    archive="node-v26.0.0-linux-$arch.tar.xz"
    base=https://nodejs.org/dist/v26.0.0
    curl --fail --silent --show-error --location --retry 3 \
        "$base/$archive" --output "$download/$archive"
    curl --fail --silent --show-error --location --retry 3 \
        "$base/SHASUMS256.txt" --output "$download/SHASUMS256.txt"
    (cd -- "$download"; grep "  $archive\$" SHASUMS256.txt | sha256sum --check --strict -)
    mkdir -p -- "$tools/node"
    tar -xJf "$download/$archive" -C "$tools/node" --strip-components=1
fi
printf '==> Toolchains ready (%ss)\n' "$((SECONDS - started))"

printf '==> Python 3.12.14 and locked development dependencies\n'
uv python install 3.12.14
uv sync --locked --python 3.12.14
# Check native libraries and prepare Pyright before the snapshot is published.
node --version
uv run --locked pyright --version

# Amp and services start in new login shells. No installs or network access on activation.
marker='# dotfiles orb toolchain'
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    {
        printf '\n%s\n' "$marker"
        printf 'if [[ "$PWD" == %q || "$PWD" == %q/* ]]; then\n' "$root" "$root"
        printf '    export PATH=%q:"$PATH"\n' "$tools/bin:$tools/node/bin"
        printf 'fi\n'
    } >> "$HOME/.bash_profile"
fi
printf '==> Orb setup complete (%ss)\n' "$((SECONDS - started))"
