# description: Create and enter a worktree from the current origin/main or a specified Git revision.
# usage: feature <branch-name> [--base|-b <base>]
emulate -L zsh
if [[ $# == 1 && ( $1 == -h || $1 == --help ) ]]; then
    print -r -- 'usage: feature <branch-name> [--base|-b <base>]'
    return
fi
if (( $# != 1 && $# != 3 )) || [[ $1 == -* ]] ||
    { (( $# == 3 )) && [[ ( $2 != --base && $2 != -b ) || -z $3 ]]; }; then
    print -u2 -- 'usage: feature <branch-name> [--base|-b <base>]'
    return 2
fi
local branch base=${3-origin/main} tip
branch=$(command git check-ref-format --branch "$1") || return $?
if [[ $branch != "$1" ]]; then
    print -u2 -- 'feature: enter a branch name'
    return 2
fi
if [[ $base == origin/* ]]; then
    local ref=${base#origin/}
    command git check-ref-format "refs/heads/$ref" || return $?
    command git fetch origin "+refs/heads/${ref}:refs/remotes/$base" || return $?
    base="refs/remotes/$base"
fi
tip=$(command git rev-parse --verify --end-of-options "${base}^{commit}") || return $?
wt switch --create "$branch" --base "$tip"
