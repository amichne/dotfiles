# Setup runner and manager for the pinned JDK and Kotlin compiler.
brew "uv"
brew "mise"

# Git helpers, the default editor, and the repository shell checks.
brew "git"
brew "gh"
brew "worktrunk"
brew "neovim"
brew "shellcheck"

# Interactive Zsh and its system integrations.
brew "zsh"
brew "zsh-autosuggestions"
brew "zsh-completions"
brew "zsh-syntax-highlighting"
brew "atuin"
brew "zoxide"
brew "starship"
brew "node" # shell-prompt

# File search, previews, directory listings, and the branch picker.
brew "ripgrep"
brew "fd"
brew "fzf"
brew "bat"
brew "eza"
brew "yazi"

# Track the diff renderer so bundle can update it between DiffNav releases.
brew "diffnav"
brew "git-delta"
brew "gum"
