{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopsentral.dev/schemas/controlled-technical-writing/text-assessment.schema.json",
  "title": "Text assessment",
  "description": "One pinned English prose policy. ASSESSED means the pipeline ran, not that a reader understood the text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schemaVersion"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "ASSESSED"
      ],
      "enum": [
        "ASSESSED",
        "INCOMPLETE",
        "REJECTED"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ],
      "examples": [
        1
      ]
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "comprehension": {
      "$ref": "#/$defs/comprehension"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      },
      "minItems": 1,
      "examples": [
        [
          {
            "type": "DOCUMENT_ASSESSMENT",
            "path": "README.md",
            "sourceSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "metrics": {
              "words": 6,
              "sentences": 1,
              "estimatedSyllables": 6,
              "wordsPerSentence": 6,
              "fleschKincaidGrade": -1.45
            },
            "findings": []
          }
        ]
      ]
    },
    "glossary": {
      "oneOf": [
        {
          "$ref": "#/$defs/checked"
        },
        {
          "$ref": "#/$defs/notProvided"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "examples": [
        {
          "type": "CHECKED",
          "entries": 1,
          "sourceSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        {
          "type": "NOT_PROVIDED"
        }
      ]
    },
    "failure": {
      "$ref": "#/$defs/failure"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/assessed"
    },
    {
      "$ref": "#/$defs/incomplete"
    },
    {
      "$ref": "#/$defs/rejected"
    }
  ],
  "discriminator": {
    "propertyName": "type"
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "examples": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "policySha256"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "VALE"
          ],
          "enum": [
            "VALE"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "3.24.0"
          ],
          "enum": [
            "3.24.0"
          ]
        },
        "policySha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "examples": [
        {
          "type": "VALE",
          "version": "3.24.0",
          "policySha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    },
    "checked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "entries",
        "sourceSha256"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "CHECKED"
          ],
          "enum": [
            "CHECKED"
          ]
        },
        "entries": {
          "type": "integer",
          "minimum": 1,
          "examples": [
            1
          ]
        },
        "sourceSha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "examples": [
        {
          "type": "CHECKED",
          "entries": 1,
          "sourceSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    },
    "notProvided": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "NOT_PROVIDED"
          ],
          "enum": [
            "NOT_PROVIDED"
          ]
        }
      },
      "examples": [
        {
          "type": "NOT_PROVIDED"
        }
      ]
    },
    "comprehension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "NOT_ASSESSED"
          ],
          "enum": [
            "NOT_ASSESSED"
          ]
        }
      },
      "examples": [
        {
          "type": "NOT_ASSESSED"
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "words",
        "sentences",
        "estimatedSyllables",
        "wordsPerSentence",
        "fleschKincaidGrade"
      ],
      "properties": {
        "words": {
          "type": "integer",
          "minimum": 1,
          "examples": [
            6
          ]
        },
        "sentences": {
          "type": "integer",
          "minimum": 1,
          "examples": [
            1
          ]
        },
        "estimatedSyllables": {
          "type": "integer",
          "minimum": 0,
          "examples": [
            6
          ]
        },
        "wordsPerSentence": {
          "type": "number",
          "minimum": 0,
          "examples": [
            6
          ]
        },
        "fleschKincaidGrade": {
          "type": "number",
          "examples": [
            -1.45
          ]
        }
      },
      "examples": [
        {
          "words": 6,
          "sentences": 1,
          "estimatedSyllables": 6,
          "wordsPerSentence": 6,
          "fleschKincaidGrade": -1.45
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "category",
        "rule",
        "severity",
        "line",
        "span",
        "message"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "FINDING"
          ],
          "enum": [
            "FINDING"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "READABILITY"
          ],
          "enum": [
            "READABILITY",
            "STRUCTURE",
            "DICTION",
            "TERMINOLOGY"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Slopsentral.Grade"
          ],
          "enum": [
            "Slopsentral.Grade",
            "Slopsentral.LongSentence",
            "Slopsentral.Diction",
            "Slopsentral.Claims",
            "Slopsentral.Terminology",
            "Slopsentral.GlossaryMarker"
          ]
        },
        "severity": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "suggestion"
          ],
          "enum": [
            "suggestion",
            "warning",
            "error"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "examples": [
            1
          ]
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "examples": [
              1
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "examples": [
            [
              1,
              7
            ]
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "examples": [
            "Consider 'use' instead of 'utilize'; preserve the source meaning."
          ]
        }
      },
      "examples": [
        {
          "type": "FINDING",
          "category": "DICTION",
          "rule": "Slopsentral.Diction",
          "severity": "warning",
          "line": 1,
          "span": [
            1,
            7
          ],
          "message": "Consider 'use' instead of 'utilize'; preserve the source meaning."
        }
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "sourceSha256",
        "metrics",
        "findings"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
