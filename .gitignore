# Public HOME inventory. Unlisted files stay private.
*
!/.gitignore
!/.python-version
!/.zshrc
!/.zshenv
!/.zprofile
!/AGENTS.md
!/.agents/
!/.agents/setup
!/.agents/resume
!/.github/
!/.github/workflows/
!/.github/workflows/sandbox.yml
!/.github/workflows/pages.yml
!/.github/README.md
!/.gradle/
!/.gradle/init.d/
!/.gradle/init.d/cache-retention.init.gradle.kts

!/.config/
!/.config/atuin/
!/.config/atuin/config.toml
!/.config/austincomplete/
!/.config/austincomplete/recipes/
!/.config/austincomplete/recipes/*.json
!/.config/git/
!/.config/git/config
!/.config/mise/
!/.config/mise/config.toml
!/.config/nvim/
!/.config/nvim/**
!/.config/worktree-inventory.toml
!/.config/worktree-reclaim.toml
!/.config/prompt.json
!/.config/starship.toml
!/.config/yazi/
!/.config/yazi/*.toml
!/.config/zsh/
!/.config/zsh/functions/
!/.config/zsh/functions/*
!/.config/shell-prompt/
!/.config/shell-prompt/*.mjs


!/.local/
!/.local/bin/
!/.local/bin/austincomplete
!/.local/bin/austincomplete.lock
!/.local/bin/dotfiles
!/.local/bin/git-recents
!/.local/bin/keys
!/.local/bin/keys.lock
!/.local/bin/setup-tools
!/.local/bin/setup-tools.lock
!/.local/bin/shell-prompt
!/.local/bin/worktrunk-commit-message
!/.local/bin/worktrunk-commit-message.lock

!/.pi/
!/.pi/agent/
!/.pi/agent/deepen.md
!/.pi/agent/pi-lsp.json
!/.pi/agent/extensions/
!/.pi/agent/extensions/deepen.ts
!/.pi/agent/extensions/ask-questions.ts
!/.pi/agent/lib/
!/.pi/agent/lib/questions.ts
!/.pi/agent/questions.json
!/.pi/agent/extensions/subagent/
!/.pi/agent/extensions/subagent/config.json
!/.pi/agent/agents/
!/.pi/agent/agents/*.md
!/.pi/agent/prompts/
!/.pi/agent/prompts/*.md

# Repository support stays under .dotfiles/, never the HOME root.
!/.dotfiles/
!/.dotfiles/AGENTS.md
!/.dotfiles/repository.md
!/.dotfiles/writing.md
!/.dotfiles/pyproject.toml
!/.dotfiles/uv.lock
!/.dotfiles/zensical.toml
!/.dotfiles/containers/
!/.dotfiles/containers/Dockerfile
!/.dotfiles/docs/
!/.dotfiles/docs/*.md
!/.dotfiles/scripts/
!/.dotfiles/scripts/*.py
!/.dotfiles/scripts/*.py.lock
!/.dotfiles/scripts/check.sh
!/.dotfiles/tests/
!/.dotfiles/tests/*.py
!/.dotfiles/tests/*.mjs
# Private controlled-English rules stay local.
/.dotfiles/controlled-english.md

# Generated state stays outside the source inventory.
**/.venv/
/.dotfiles/site/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.DS_Store
