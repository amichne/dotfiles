# Public HOME inventory. Unlisted files stay private.
*
!/.gitignore
!/.python-version
!/.zshrc
!/.zprofile
!/README.md
!/pyproject.toml
!/uv.lock
!/zensical.toml
!/containers/
!/containers/Dockerfile
!/.agents/
!/.agents/setup
!/.agents/resume
!/.github/
!/.github/workflows/
!/.github/workflows/sandbox.yml

!/.config/
!/.config/atuin/
!/.config/atuin/config.toml
!/.config/mise/
!/.config/mise/config.toml
!/.config/nvim/
!/.config/nvim/**
!/.config/prompt.json
!/.config/starship.toml
!/.config/yazi/
!/.config/yazi/*.toml
!/.config/zsh/
!/.config/zsh/functions/
!/.config/zsh/functions/*
!/.config/shell-prompt/
!/.config/shell-prompt/*.mjs
!/.config/agent-engineering/
!/.config/agent-engineering/B0.md


!/.local/
!/.local/bin/
!/.local/bin/df
!/.local/bin/keys
!/.local/bin/keys.lock
!/.local/bin/shell-prompt

!/.pi/
!/.pi/agent/
!/.pi/agent/deepen.md
!/.pi/agent/pi-lsp.json
!/.pi/agent/extensions/
!/.pi/agent/extensions/deepen.ts
!/.pi/agent/extensions/ask-questions.ts
!/.pi/agent/lib/
!/.pi/agent/lib/questions.ts
!/.pi/agent/questions.json
!/.pi/agent/extensions/subagent/
!/.pi/agent/extensions/subagent/config.json
!/.pi/agent/agents/
!/.pi/agent/agents/*.md
!/.pi/agent/prompts/
!/.pi/agent/prompts/*.md

!/docs/
!/docs/*.md
!/scripts/
!/scripts/*.py
!/scripts/*.py.lock
!/scripts/check.sh
!/tests/
!/tests/*.py
!/tests/*.mjs

# Generated state stays outside the source inventory.
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.DS_Store
