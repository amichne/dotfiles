# Public HOME inventory. Unlisted files stay private.
*
!/.gitignore
!/.python-version
!/.zshrc
!/.zprofile
!/AGENTS.md
!/README.md
!/pyproject.toml
!/uv.lock
!/zensical.toml

!/.config/
!/.config/atuin/
!/.config/atuin/config.toml
!/.config/mise/
!/.config/mise/config.toml
!/.config/nvim/
!/.config/nvim/**
!/.config/prompt.json
!/.config/starship.toml
!/.config/yazi/
!/.config/yazi/*.toml
!/.config/zsh/
!/.config/zsh/functions/
!/.config/zsh/functions/*
!/.config/shell-prompt/
!/.config/shell-prompt/*.mjs

!/.local/
!/.local/bin/
!/.local/bin/df
!/.local/bin/dotfiles
!/.local/bin/keys
!/.local/bin/keys.lock
!/.local/bin/shell-prompt

!/.pi/
!/.pi/agent/
!/.pi/agent/APPEND_SYSTEM.md
!/.pi/agent/pi-lsp.json
!/.pi/agent/agents/
!/.pi/agent/agents/*.md
!/.pi/agent/prompts/
!/.pi/agent/prompts/*.md

!/ai/
!/ai/**
!/bin/
!/bin/ai
!/bin/dotfiles
!/docs/
!/docs/*.md
!/scripts/
!/scripts/*.py
!/scripts/*.py.lock
!/scripts/check.sh
!/tests/
!/tests/*.py
!/tests/*.mjs

# Generated state stays outside the source inventory.
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.DS_Store
