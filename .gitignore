# Public HOME inventory. Unlisted files stay private.
*
!/.gitignore
!/.python-version
!/.zshrc
!/.zprofile
!/AGENTS.md
!/README.md
!/pyproject.toml
!/uv.lock
!/zensical.toml
!/containers/
!/containers/Dockerfile
!/.github/
!/.github/workflows/
!/.github/workflows/sandbox.yml

!/.config/
!/.config/atuin/
!/.config/atuin/config.toml
!/.config/mise/
!/.config/mise/config.toml
!/.config/nvim/
!/.config/nvim/**
!/.config/prompt.json
!/.config/starship.toml
!/.config/yazi/
!/.config/yazi/*.toml
!/.config/zsh/
!/.config/zsh/functions/
!/.config/zsh/functions/*
!/.config/shell-prompt/
!/.config/shell-prompt/*.mjs
!/.config/agent-engineering/
!/.config/agent-engineering/*.md
!/.config/agent-engineering/*.py
!/.config/agent-engineering/*.py.lock

!/.codex/
!/.codex/AGENTS.md
!/.codex/hooks.json

!/.local/
!/.local/bin/
!/.local/bin/df
!/.local/bin/keys
!/.local/bin/keys.lock
!/.local/bin/shell-prompt
!/.local/bin/agent-check

!/.pi/
!/.pi/agent/
!/.pi/agent/APPEND_SYSTEM.md
!/.pi/agent/pi-lsp.json
!/.pi/agent/agents/
!/.pi/agent/agents/*.md
!/.pi/agent/prompts/
!/.pi/agent/prompts/*.md
!/.pi/agent/extensions/
!/.pi/agent/extensions/engineering-checks.ts

!/docs/
!/docs/*.md
!/scripts/
!/scripts/*.py
!/scripts/*.py.lock
!/scripts/check.sh
!/tests/
!/tests/*.py
!/tests/*.mjs

# Generated state stays outside the source inventory.
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.DS_Store
