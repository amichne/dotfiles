#!/usr/bin/env -S uv run --offline --locked --script
# /// script
# requires-python = ">=3.12,<3.14"
# dependencies = []
# [tool.uv]
# no-build = true
# required-version = ">=0.12.9"
# [[tool.uv.index]]
# name = "pypi"
# url = "https://pypi.org/simple"
# default = true
# ///
"""Store trusted Zsh completions and replay explicit generator argument vectors."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Literal, TypeGuard, assert_never

LIMIT = 4 * 1024 * 1024
NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.+\-]{0,127}\Z")


@dataclass(frozen=True, slots=True)
class Rejected:
    reason: Literal[
        "invalid-name",
        "invalid-recipe",
        "not-registered",
        "static-completion",
        "empty-completion",
        "completion-too-large",
        "invalid-completion",
        "missing-command",
        "generator-failed",
        "timed-out",
        "unsafe-path",
        "io-failed",
        "stdin-required",
    ]
    status: int = 2


@dataclass(frozen=True, slots=True)
class CommandName:
    value: str

    def __post_init__(self) -> None:
        if not NAME.fullmatch(self.value):
            raise ValueError("CommandName requires a safe command basename")


def parse_name(raw: str) -> CommandName | Rejected:
    return CommandName(raw) if NAME.fullmatch(raw) else Rejected("invalid-name")


@dataclass(frozen=True, slots=True)
class Generator:
    executable: str
    arguments: tuple[str, ...]

    def __post_init__(self) -> None:
        if not self.executable or any("\0" in arg for arg in self.argv):
            raise ValueError("Generator requires a nonempty executable and NUL-free arguments")

    @property
    def argv(self) -> tuple[str, ...]:
        return (self.executable, *self.arguments)


@dataclass(frozen=True, slots=True)
class Static:
    pass


type Recipe = Generator | Static


def is_list(raw: object) -> TypeGuard[list[object]]:
    return isinstance(raw, list)


def is_record(raw: object) -> TypeGuard[dict[object, object]]:
    return isinstance(raw, dict)


def parse_generator(raw: object) -> Generator | Rejected:
    if not is_list(raw):
        return Rejected("invalid-recipe")
    values: list[object] = raw
    args: list[str] = []
    for value in values:
        if not isinstance(value, str) or "\0" in value:
            return Rejected("invalid-recipe")
        args.append(value)
    if not args or not args[0]:
        return Rejected("invalid-recipe")
    return Generator(args[0], tuple(args[1:]))


def parse_recipe(raw: object) -> Recipe | Rejected:
    if not is_record(raw):
        return Rejected("invalid-recipe")
    record: dict[object, object] = raw
    if type(record.get("version")) is not int or record.get("version") != 1:
        return Rejected("invalid-recipe")
    match record.get("kind"):
        case "static" if set(record) == {"version", "kind"}:
            return Static()
        case "generator" if set(record) == {"version", "kind", "argv"}:
            return parse_generator(record["argv"])
        case _:
            return Rejected("invalid-recipe")


def encode_recipe(recipe: Recipe) -> bytes:
    match recipe:
        case Generator():
            record = {"version": 1, "kind": "generator", "argv": recipe.argv}
        case Static():
            record = {"version": 1, "kind": "static"}
        case _:
            assert_never(recipe)
    return (json.dumps(record, indent=2) + "\n").encode()


@dataclass(frozen=True, slots=True)
class Layout:
    config: Path
    cache: Path

    def recipe(self, name: CommandName) -> Path:
        return self.config / "recipes" / (name.value + ".json")

    def completion(self, name: CommandName) -> Path:
        return self.cache / "zsh" / ("_" + name.value)


def safe_path(path: Path, root: Path) -> Rejected | None:
    for current in (path, *path.parents):
        if current.is_symlink():
            return Rejected("unsafe-path")
        if current.exists() and (
            (current == path and not current.is_file())
            or (current != path and not current.is_dir())
        ):
            return Rejected("unsafe-path")
        if current == root:
            break
    return None


def destinations(layout: Layout, name: CommandName) -> Rejected | None:
    return safe_path(layout.recipe(name), layout.config) or safe_path(
        layout.completion(name), layout.cache
    )


def unique_record(pairs: list[tuple[str, object]]) -> dict[str, object] | Rejected:
    record: dict[str, object] = {}
    for key, value in pairs:
        if key in record:
            return Rejected("invalid-recipe")
        record[key] = value
    return record


def load_recipe(layout: Layout, name: CommandName) -> Recipe | Rejected:
    path = layout.recipe(name)
    rejected = safe_path(path, layout.config)
    if rejected:
        return rejected
    try:
        with path.open("rb") as stream:
            data = stream.read(64 * 1024 + 1)
    except FileNotFoundError:
        return Rejected("not-registered")
    if len(data) > 64 * 1024:
        return Rejected("invalid-recipe")
    try:
        raw: object = json.loads(data, object_pairs_hook=unique_record)
    except (ValueError, UnicodeDecodeError):
        return Rejected("invalid-recipe")
    return parse_recipe(raw)


def registrations(layout: Layout) -> tuple[tuple[CommandName, Recipe], ...] | Rejected:
    entries: list[tuple[CommandName, Recipe]] = []
    directory = layout.config / "recipes"
    rejected = safe_path(directory / "probe", layout.config)
    if rejected:
        return rejected
    for path in sorted(directory.glob("*.json")):
        name = parse_name(path.stem)
        if isinstance(name, Rejected):
            return name
        recipe = load_recipe(layout, name)
        if isinstance(recipe, Rejected):
            return recipe
        entries.append((name, recipe))
    return tuple(entries)


def generate(recipe: Generator) -> bytes | Rejected:
    # Temporary output avoids retaining an unbounded generator payload in memory.
    with tempfile.TemporaryFile() as output:
        try:
            result = subprocess.run(
                recipe.argv,
                stdin=subprocess.DEVNULL,
                stdout=output,
                stderr=subprocess.DEVNULL,
                timeout=30,
                check=False,
            )
        except FileNotFoundError:
            return Rejected("missing-command", 127)
        except subprocess.TimeoutExpired:
            return Rejected("timed-out", 124)
        if result.returncode:
            return Rejected(
                "generator-failed",
                result.returncode if result.returncode > 0 else 128 - result.returncode,
            )
        _ = output.seek(0)
        return output.read(LIMIT + 1)


@dataclass(frozen=True, slots=True)
class _Completion:
    # Constructed only by validate_completion after the real Zsh syntax check.
    content: bytes


def validate_completion(name: CommandName, content: bytes) -> _Completion | Rejected:
    if not content.strip():
        return Rejected("empty-completion")
    if len(content) > LIMIT:
        return Rejected("completion-too-large")
    try:
        text = content.decode("utf-8")
        header = shlex.split(text.splitlines()[0])
    except (UnicodeDecodeError, ValueError):
        return Rejected("invalid-completion")
    if "\0" in text or len(header) < 2 or header[0] != "#compdef" or name.value not in header[1:]:
        return Rejected("invalid-completion")
    # Only simple command registrations, not compdef pattern/options protocols.
    if any(not NAME.fullmatch(value) for value in header[1:]):
        return Rejected("invalid-completion")
    try:
        result = subprocess.run(
            ["zsh", "-dfn"],
            input=content,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
            check=False,
        )
    except FileNotFoundError:
        return Rejected("missing-command", 127)
    except subprocess.TimeoutExpired:
        return Rejected("timed-out", 124)
    if result.returncode:
        return Rejected("invalid-completion")
    return _Completion(content if content.endswith(b"\n") else content + b"\n")


def atomic_write(path: Path, content: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=".pending-", delete=False) as stream:
        pending = Path(stream.name)
        try:
            _ = stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
            os.replace(pending, path)
        finally:
            pending.unlink(missing_ok=True)


def save(
    layout: Layout, name: CommandName, recipe: Recipe, completion: _Completion
) -> Rejected | None:
    rejected = destinations(layout, name)
    if rejected:
        return rejected
    # Each replacement is atomic; an I/O error between files is reported, not rolled back.
    atomic_write(layout.recipe(name), encode_recipe(recipe))
    atomic_write(layout.completion(name), completion.content)
    return None


class Arguments(argparse.Namespace):
    action: Literal["add", "update", "list"] | None
    name: str | None
    stdin: bool
    all: bool
    json: bool


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        description=__doc__,
        epilog="Example: austincomplete add -- atuin gen-completions --shell zsh",
        allow_abbrev=False,
    )
    commands = root.add_subparsers(dest="action")
    add = commands.add_parser(
        "add", help="Save completion output and its optional generator", allow_abbrev=False
    )
    _ = add.add_argument(
        "name", nargs="?", help="Caller name; defaults to generator executable basename"
    )
    _ = add.add_argument(
        "--stdin", action="store_true", help="Read piped output even when a generator follows --"
    )
    add.epilog = "Use add [name] -- executable args... to run and remember a generator. Without a generator, add name reads stdin."
    update = commands.add_parser(
        "update", help="Replay a saved generator using the current PATH", allow_abbrev=False
    )
    selection = update.add_mutually_exclusive_group(required=True)
    _ = selection.add_argument(
        "--all", action="store_true", help="Update every generator; skip static completions"
    )
    _ = selection.add_argument("name", nargs="?", help="Registered caller to update")
    listing = commands.add_parser(
        "list", help="Show registered callers and their generators", allow_abbrev=False
    )
    _ = listing.add_argument(
        "--json", action="store_true", help="Emit a JSON array instead of human text"
    )
    return root


def report(rejected: Rejected, name: str = "") -> int:
    print(f"austincomplete: {name + ': ' if name else ''}{rejected.reason}", file=sys.stderr)
    return rejected.status


def add(layout: Layout, args: Arguments, generator: Generator | Static) -> int:
    inferred = Path(generator.executable).name if isinstance(generator, Generator) else ""
    name = parse_name(args.name or inferred)
    if isinstance(name, Rejected):
        return report(name)
    rejected = destinations(layout, name)
    if rejected:
        return report(rejected, name.value)
    if args.stdin or isinstance(generator, Static):
        if sys.stdin.isatty():
            return report(Rejected("stdin-required"), name.value)
        output = sys.stdin.buffer.read(LIMIT + 1)
    else:
        output = generate(generator)
    if isinstance(output, Rejected):
        return report(output, name.value)
    completion = validate_completion(name, output)
    if isinstance(completion, Rejected):
        return report(completion, name.value)
    rejected = save(layout, name, generator, completion)
    if rejected:
        return report(rejected, name.value)
    print(f"saved {name.value} ({'generator' if isinstance(generator, Generator) else 'static'})")
    return 0


def update(layout: Layout, args: Arguments) -> int:
    if args.all:
        entries = registrations(layout)
        if isinstance(entries, Rejected):
            return report(entries)
    else:
        name = parse_name(args.name or "")
        if isinstance(name, Rejected):
            return report(name)
        recipe = load_recipe(layout, name)
        if isinstance(recipe, Rejected):
            return report(recipe, name.value)
        entries = ((name, recipe),)
    status = 0
    for name, recipe in entries:
        if isinstance(recipe, Static):
            if args.all:
                print(f"skipped-static {name.value}")
            else:
                status = report(Rejected("static-completion"), name.value)
            continue
        rejected = destinations(layout, name)
        if rejected:
            status = report(rejected, name.value)
            continue
        output = generate(recipe)
        if isinstance(output, Rejected):
            status = report(output, name.value)
            continue
        completion = validate_completion(name, output)
        if isinstance(completion, Rejected):
            status = report(completion, name.value)
            continue
        rejected = save(layout, name, recipe, completion)
        if rejected:
            status = report(rejected, name.value)
            continue
        print(f"updated {name.value}")
    if not entries:
        print("0 completions registered")
    return status


def listing(layout: Layout, as_json: bool) -> int:
    entries = registrations(layout)
    if isinstance(entries, Rejected):
        return report(entries)
    if as_json:
        print(
            json.dumps(
                [
                    {"command": name.value, "kind": "generator", "argv": recipe.argv}
                    if isinstance(recipe, Generator)
                    else {"command": name.value, "kind": "static"}
                    for name, recipe in entries
                ]
            )
        )
    elif not entries:
        print("0 completions registered")
    else:
        for name, recipe in entries:
            print(
                f"{name.value}\t{shlex.join(recipe.argv) if isinstance(recipe, Generator) else '(static; no generator)'}"
            )
    return 0


def main() -> int:
    root = parser()
    argv = sys.argv[1:]
    generator: Generator | Static = Static()
    if "--" in argv:
        split = argv.index("--")
        raw = argv[split + 1 :]
        argv = argv[:split]
        if not argv or argv[0] != "add" or not raw:
            root.error("only add accepts a nonempty generator after --")
        parsed = parse_generator(raw)
        if isinstance(parsed, Rejected):
            return report(parsed)
        generator = parsed
    args = root.parse_args(argv, namespace=Arguments())
    home = Path.home()
    layout = Layout(
        Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config").resolve() / "austincomplete",
        Path(os.environ.get("XDG_CACHE_HOME") or home / ".cache").resolve() / "austincomplete",
    )
    try:
        action = args.action
        if action is None or action == "list":
            return listing(layout, args.json if action == "list" else False)
        # Serialize recipe/cache changes and update reads across cooperating processes.
        lock = layout.cache / ".lock"
        rejected = safe_path(lock, layout.cache)
        if rejected:
            return report(rejected)
        lock.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with lock.open("a+b") as stream:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
            match action:
                case "add":
                    return add(layout, args, generator)
                case "update":
                    return update(layout, args)
                case _:
                    assert_never(action)
    except OSError:
        return report(Rejected("io-failed", 1))


if __name__ == "__main__":
    raise SystemExit(main())
